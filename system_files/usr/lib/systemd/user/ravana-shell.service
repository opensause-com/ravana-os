[Unit]
Description=Ravana Shell (menu bar, dock, Launchpad, Control Center)
PartOf=graphical-session.target
After=plasma-kwin_wayland.service
Before=plasma-workspace.target

[Service]
ExecStart=/usr/bin/quickshell -p /usr/share/ravana/shell
Restart=on-failure
RestartSec=1
Slice=session.slice
# Apps opened from the dock, Launchpad and menus are children of the shell: if the shell
# restarts, only the shell itself is stopped, never the apps
KillMode=process

[Install]
WantedBy=plasma-workspace.target
