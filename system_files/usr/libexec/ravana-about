#!/usr/bin/env bash
# Copyright (c) 2026 Ravana OS. All rights reserved.
# Facts for Ravana Settings > About (key=value lines).
. /etc/os-release 2>/dev/null
echo "name=${NAME:-Ravana OS}"
echo "version=${IMAGE_VERSION:-${VERSION:-}}"
echo "base=Fedora ${REDHAT_SUPPORT_PRODUCT_VERSION:-${VERSION_ID:-}}"
echo "image=Ravana OS ${IMAGE_VERSION:-}"
echo "kernel=$(uname -r)"
echo "chip=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)"
echo "cores=$(nproc)"
echo "memory=$(awk '/MemTotal/ {printf "%.0f GB", $2/1048576}' /proc/meminfo)"
echo "graphics=$(lspci 2>/dev/null | sed -n 's/.*\(VGA\|3D\|Display\)[^:]*: //p' | sed 's/ (rev .*//' | head -2 | paste -sd ' + ')"
echo "disk=$(df -h --output=avail,size "${HOME:-/var/home}" 2>/dev/null | tail -1 | awk '{print $1 " free of " $2}')"
echo "host=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null)"
echo "channel=$(bootc status --format=json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["status"]["booted"]["image"]["image"]["image"])' 2>/dev/null)"
