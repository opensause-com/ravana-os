[Desktop Entry]
Type=Application
Name=Reset Ravana Look
GenericName=Restore Default Appearance
Comment=Bring back the Ravana menu bar, dock, theme, window style and Mac shortcuts
Icon=ravana-os
Exec=/usr/libexec/ravana-look-update --now
Terminal=false
Categories=Settings;
Keywords=theme;look;reset;layout;dock;ravana;
