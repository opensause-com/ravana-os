#!/usr/bin/python3 -I
# Copyright (c) 2026 Ravana OS. All rights reserved.
"""Ravana lock and logout screens on top of Plasma's own session logic.

Logout: Plasma's LogoutControls.qml (only the look) is replaced by Ravana's, which calls
the same actions; Logout.qml (the logic) stays Plasma's. Installed only if Plasma's file
still offers exactly the actions Ravana's uses.

Lock screen: Give Plasma's lock screen the Ravana look without touching how it unlocks.

Only visual pieces of LockScreenUi.qml change: KDE's clock is replaced by the Ravana
clock (date above a large time) and a soft crown sits at the top. Every edit must find
its exact anchor; if any is missing (a newer Plasma), nothing is written and the stock
lock screen stays. Safe to run more than once."""
import sys, shutil
from pathlib import Path

UI = Path("/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml")
MARK = "// ravana-lockscreen-style v4"

# Sharp wallpaper over Plasma's blurred one (macOS shows the wallpaper as it is)
SHARP = '''
        // Ravana: the wallpaper stays sharp, only a light veil for legibility
        Image {
            anchors.fill: parent
            source: "file:///usr/share/wallpapers/RavanaLanka/contents/images/3840x2160.png"
            sourceSize: Qt.size(lockScreenRoot.width, lockScreenRoot.height)
            fillMode: Image.PreserveAspectCrop
            asynchronous: false
            Rectangle { anchors.fill: parent; color: Qt.rgba(0, 0, 0, 0.18) }
        }

        DropShadow {
            id: clockShadow'''

# Status in the top-right corner, and Shut Down / Restart / Sleep along the bottom
CHROME = '''
        // Ravana: battery and time, top right
        RowLayout {
            anchors.top: parent.top; anchors.right: parent.right
            anchors.topMargin: 6; anchors.rightMargin: 14
            spacing: 12
            Battery {}
            Text {
                id: ravanaTime
                property date now: new Date()
                Timer { interval: 1000; running: true; repeat: true; onTriggered: ravanaTime.now = new Date() }
                text: Qt.formatDate(now, "ddd d MMM") + "   " + Qt.formatTime(now, Qt.locale().timeFormat(Locale.ShortFormat))
                color: "white"
                font.family: "Inter"; font.pixelSize: 13; font.weight: Font.Medium
            }
        }

        // Ravana: Shut Down / Restart / Sleep, round glass buttons at the bottom
        Row {
            id: ravanaPower
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            anchors.bottomMargin: Math.round(parent.height * 0.06)
            spacing: 44
            Repeater {
                model: [
                    { label: i18nd("plasma_shell_org.kde.plasma.desktop", "&Shut Down").replace("&", ""), icon: "system-shutdown", act: 0, show: true },
                    { label: i18nd("plasma_shell_org.kde.plasma.desktop", "&Restart").replace("&", ""), icon: "system-reboot", act: 1, show: true },
                    { label: i18ndc("plasma_shell_org.kde.plasma.desktop", "@action:button", "Slee&p").replace("&", ""), icon: "system-suspend", act: 2, show: true }
                ]
                Column {
                    id: powerItem
                    required property var modelData
                    visible: modelData.show
                    spacing: 8
                    Rectangle {
                        anchors.horizontalCenter: parent.horizontalCenter
                        width: 44; height: 44; radius: 22
                        color: Qt.rgba(1, 1, 1, powerArea.containsMouse ? 0.30 : 0.18)
                        border.width: 1; border.color: Qt.rgba(1, 1, 1, 0.25)
                        Kirigami.Icon {
                            anchors.centerIn: parent
                            width: 20; height: 20
                            source: powerItem.modelData.icon
                            color: "white"; isMask: true
                        }
                        MouseArea {
                            id: powerArea
                            anchors.fill: parent
                            hoverEnabled: true
                            onClicked: {
                                if (powerItem.modelData.act === 0) sessionManagement.requestShutdown();
                                else if (powerItem.modelData.act === 1) sessionManagement.requestReboot();
                                else sessionManagement.suspend();
                            }
                        }
                    }
                    Text {
                        anchors.horizontalCenter: parent.horizontalCenter
                        text: powerItem.modelData.label
                        color: "white"
                        font.family: "Inter"; font.pixelSize: 12; font.weight: Font.Medium
                    }
                }
            }
        }
'''

EDITS = [
    # KDE's big clock and its shadow are not part of this design
    ("visible: y > 0 && config.alwaysShowClock", "visible: false"),
    ("visible: !lockScreenUi.softwareRendering && config.alwaysShowClock", "visible: false"),
    # sharp wallpaper above the blurred one, below everything else
    ("\n        DropShadow {\n            id: clockShadow", SHARP),
    # status and power row
    ("        ListModel {\n            id: users", CHROME + "\n        ListModel {\n            id: users"),
    # Plasma's small action buttons under the password and its footer give way to the above
    ("visible: sessionManagement.canSuspend", "visible: false"),
    ("visible: sessionManagement.canHibernate", "visible: false"),
    ("visible: sessionManagement.canSwitchUser", "visible: false"),
    ("        RowLayout {\n            id: footer", "        RowLayout {\n            id: footer\n            visible: false"),
]

SHELL = Path("/usr/share/plasma/shells/org.kde.plasma.desktop/contents")
RAVANA_LOGOUT = Path("/usr/share/ravana/session/LogoutControls.qml")
LOGOUT_API = ["readonly property Item hostRoot: parent", "controls.hostRoot.sleepRequested()",
              "controls.hostRoot.hibernateRequested()", "controls.hostRoot.rebootRequested()",
              "controls.hostRoot.rebootUpdateRequested()", "controls.hostRoot.haltRequested()",
              "controls.hostRoot.haltUpdateRequested()", "controls.hostRoot.logoutRequested()",
              "controls.hostRoot.cancelRequested()", "spdMethods.SuspendState", "canLogout", "maysd"]

def logout():
    ctl = SHELL / "logout/LogoutControls.qml"
    if not ctl.exists() or not RAVANA_LOGOUT.exists():
        print("no Plasma logout screen"); return
    orig = ctl.with_suffix(".qml.kde")
    kde = (orig if orig.exists() else ctl).read_text()
    missing = [a for a in LOGOUT_API if a not in kde]
    if missing:
        print("WARNING: Plasma's logout screen changed, keeping it:", missing); return
    if not orig.exists():
        shutil.copy2(ctl, orig)
    shutil.copy2(RAVANA_LOGOUT, ctl)
    # a lighter veil behind the Ravana alert (Plasma uses near-black)
    lo = SHELL / "logout/Logout.qml"
    t = lo.read_text()
    if t.count('color: "black"\n        opacity: 0.85') == 1:
        lo.write_text(t.replace('color: "black"\n        opacity: 0.85', 'color: "black"\n        opacity: 0.45'))
    print("logout screen: Ravana alert applied")

# Password row, macOS style: a frosted capsule field and a round arrow button
MAINBLOCK = SHELL / "lockscreen/MainBlock.qml"
MB_MARK = "// ravana-mainblock-style v4"
MB_EDITS = [
    # centre the row under the avatar; a spacer the size of the arrow keeps the
    # capsule itself exactly centred when the arrow appears on its right
    ("    RowLayout {\n        id: passwordLayout\n        Layout.fillWidth: true\n",
     "    RowLayout {\n        id: passwordLayout\n        Layout.fillWidth: false\n"
     "        Layout.alignment: Qt.AlignHCenter\n"
     "        spacing: 6\n"
     "        Item { visible: loginButton.visible; Layout.preferredWidth: 30; Layout.preferredHeight: 30 }\n"),
    ('"@info:placeholder in text field", "Password")',
     '"@info:placeholder in text field", "Enter Password")'),
    # same capsule as the Ravana login screen: 200 x 30, centred text, 13 px
    ("            font.pointSize: Kirigami.Theme.defaultFont.pointSize + 1\n",
     "            font.pixelSize: 13\n"
     "            font.family: \"Inter\"\n"),
    ("            cursorVisible: visible\n",
     "            cursorVisible: visible\n"
     "            Layout.preferredWidth: 200\n"
     "            Layout.preferredHeight: 30\n"
     "            Layout.alignment: Qt.AlignHCenter\n"
     "            horizontalAlignment: TextInput.AlignHCenter\n"
     "            leftPadding: 14; rightPadding: 14; topPadding: 0; bottomPadding: 0\n"
     "            color: \"white\"\n"
     "            placeholderTextColor: \"transparent\"\n"
     "            rightActions: []\n"
     "            passwordCharacter: \"\u25cf\"\n"
     "            background: Rectangle {\n"
     "                radius: 15\n"
     "                color: Qt.rgba(1, 1, 1, passwordBox.activeFocus ? 0.26 : 0.18)\n"
     "                border.width: 1\n"
     "                border.color: Qt.rgba(1, 1, 1, 0.25)\n"
     "                Text {\n"
     "                    anchors.centerIn: parent\n"
     "                    visible: passwordBox.text.length === 0\n"
     "                    text: passwordBox.placeholderText\n"
     "                    color: Qt.rgba(1, 1, 1, 0.6)\n"
     "                    font.family: \"Inter\"; font.pixelSize: 13\n"
     "                }\n"
     "            }\n"),
    ("            Layout.fillWidth: true\n            text: PasswordSync.password\n",
     "            Layout.fillWidth: false\n            text: PasswordSync.password\n"),
    # the round arrow appears once you type, like the login screen
    ("            Layout.preferredWidth: loginButton.Layout.preferredHeight\n",
     "            Layout.preferredWidth: 30\n"
     "            visible: passwordBox.text.length > 0\n"),
    ("            onClicked: sessionManager.startLogin()\n",
     "            onClicked: sessionManager.startLogin()\n"
     "            background: Rectangle {\n"
     "                radius: height / 2\n"
     "                color: Qt.rgba(1, 1, 1, loginButton.hovered ? 0.28 : 0.16)\n"
     "                border.width: 1\n"
     "                border.color: Qt.rgba(1, 1, 1, 0.22)\n"
     "            }\n"),
]

def mainblock():
    if not MAINBLOCK.exists():
        return
    orig = MAINBLOCK.with_suffix(".qml.kde")
    s = (orig if orig.exists() else MAINBLOCK).read_text()
    for old, _ in MB_EDITS:
        if s.count(old) != 1:
            print("WARNING: lock screen password row changed, keeping Plasma's:", old.splitlines()[0]); return
    if not orig.exists():
        shutil.copy2(MAINBLOCK, orig)
    for old, new in MB_EDITS:
        s = s.replace(old, new)
    MAINBLOCK.write_text(MB_MARK + "\n" + s)
    print("lock screen: Ravana password capsule applied")

def main():
    logout()
    mainblock()
    if not UI.exists():
        print("no Plasma lock screen at", UI); return 0
    s = UI.read_text()
    if MARK in s:
        print("already Ravana-styled"); return 0
    orig = UI.with_suffix(".qml.kde")
    if "// ravana-lockscreen-style" in s and orig.exists():
        s = orig.read_text()          # older Ravana style: start again from KDE's file
    for old, _ in EDITS:
        if s.count(old) != 1:
            print("WARNING: lock screen layout changed (anchor not found once):", old.splitlines()[0])
            print("leaving the stock lock screen untouched"); return 0
    for old, new in EDITS:
        s = s.replace(old, new)
    if not orig.exists():
        shutil.copy2(UI, orig)
    UI.write_text(MARK + "\n" + s)
    print("lock screen: Ravana clock applied")
    return 0

sys.exit(main())
