#!/usr/bin/env bash
# Ravana Control Center backend.
#   ravana-cc status                  -> key=value lines
#   ravana-cc wifi on|off
#   ravana-cc bluetooth on|off
#   ravana-cc volume <0-100>
#   ravana-cc mute toggle
#   ravana-cc brightness <0-100>
#   ravana-cc focus on|off            (Do Not Disturb)
#   ravana-cc wifi-list               -> in-use<TAB>ssid<TAB>signal<TAB>security
#   ravana-cc wifi-connect <ssid> [--password-stdin]   (password read from stdin)
#   ravana-cc bt-list                 -> mac<TAB>name<TAB>connected
#   ravana-cc bt-device <mac>         (connect / disconnect)
set -u
SINK=@DEFAULT_AUDIO_SINK@
KW="$(command -v kwriteconfig6 || ls /usr/bin/kwriteconfig6 /usr/sbin/kwriteconfig6 2>/dev/null | head -1)"
KR="$(command -v kreadconfig6 || ls /usr/bin/kreadconfig6 /usr/sbin/kreadconfig6 2>/dev/null | head -1)"

bright_dev() {   # KDE's per-display brightness object, if any
    busctl --user --list tree org.kde.ScreenBrightness 2>/dev/null | grep -o '/org/kde/ScreenBrightness/display[0-9]*' | head -1
}

status() {
    # Wi-Fi
    if command -v nmcli >/dev/null; then
        echo "wifi_available=$(nmcli -t -f TYPE dev 2>/dev/null | grep -qx wifi && echo 1 || echo 0)"
        echo "wifi_on=$( [ "$(nmcli -t -f WIFI radio 2>/dev/null)" = enabled ] && echo 1 || echo 0)"
        echo "wifi_name=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1)"
        echo "net_wired=$(nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q '^ethernet:connected' && echo 1 || echo 0)"
    else
        echo "wifi_available=0"
    fi
    # Bluetooth
    if command -v bluetoothctl >/dev/null && bluetoothctl list 2>/dev/null | grep -q Controller; then
        echo "bt_available=1"
        echo "bt_on=$(bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo 1 || echo 0)"
        echo "bt_devices=$(bluetoothctl devices Connected 2>/dev/null | sed 's/^Device [^ ]* //' | paste -sd ', ')"
    else
        echo "bt_available=0"
    fi
    # Sound
    if v="$(wpctl get-volume "$SINK" 2>/dev/null)"; then
        echo "volume=$(awk '{printf "%d", $2 * 100 + 0.5}' <<<"$v")"
        echo "muted=$(grep -q MUTED <<<"$v" && echo 1 || echo 0)"
        echo "sound_available=1"
    else
        echo "sound_available=0"
    fi
    # Brightness
    d="$(bright_dev)"
    if [ -n "$d" ]; then
        cur=$(busctl --user get-property org.kde.ScreenBrightness "$d" org.kde.ScreenBrightness.Display Brightness 2>/dev/null | awk '{print $2}')
        max=$(busctl --user get-property org.kde.ScreenBrightness "$d" org.kde.ScreenBrightness.Display MaxBrightness 2>/dev/null | awk '{print $2}')
        if [ -n "$cur" ] && [ -n "$max" ] && [ "$max" -gt 0 ]; then
            echo "brightness_available=1"; echo "brightness=$(( cur * 100 / max ))"
        else
            echo "brightness_available=0"
        fi
    else
        echo "brightness_available=0"
    fi
    # Focus (Plasma's Do Not Disturb)
    until="$("$KR" --file plasmanotifyrc --group DoNotDisturb --key Until 2>/dev/null)"
    if [ -n "$until" ] && [ "$(date -d "$until" +%s 2>/dev/null || echo 0)" -gt "$(date +%s)" ]; then
        echo "focus_on=1"
    else
        echo "focus_on=0"
    fi
    # Appearance
    echo "dark=$( "$KR" --file kdeglobals --group General --key ColorScheme 2>/dev/null | grep -qi light && echo 0 || echo 1)"
}

case "${1:-status}" in
    status) status ;;
    kbd)    # keyboard layouts (KWin): how many, and the current one's short name
        list="$(busctl --user call org.kde.keyboard /Layouts org.kde.KeyboardLayouts getLayoutsList 2>/dev/null)"
        cur="$(busctl --user call org.kde.keyboard /Layouts org.kde.KeyboardLayouts getLayout 2>/dev/null | awk '{print $2}')"
        count="$(awk '{print $2}' <<<"$list")"
        echo "count=${count:-0}"
        # entries are ("short" "variant" "long") triples after the count
        short="$(grep -o '"[^"]*"' <<<"$list" | sed -n "$(( ${cur:-0} * 3 + 1 ))p" | tr -d '"')"
        echo "current=${short}" ;;
    mic)    # privacy: how many apps are recording from a microphone right now
        n=$(pactl list short source-outputs 2>/dev/null | grep -vc 'monitor' || true)
        echo "mic=${n:-0}" ;;
    net)    # just what the menu bar's network icon needs (cheap, polled)
        echo "wifi_on=$( [ "$(nmcli -t -f WIFI radio 2>/dev/null)" = enabled ] && echo 1 || echo 0)"
        echo "wifi_name=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1)"
        echo "net_wired=$(nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q '^ethernet:connected' && echo 1 || echo 0)" ;;
    wifi) nmcli radio wifi "$2" ;;
    bluetooth) bluetoothctl power "$2" >/dev/null ;;
    volume) wpctl set-mute "$SINK" 0; wpctl set-volume "$SINK" "$(awk -v v="$2" 'BEGIN {printf "%.2f", v / 100}')" ;;
    mute) wpctl set-mute "$SINK" toggle ;;
    brightness)
        d="$(bright_dev)"; [ -n "$d" ] || exit 1
        max=$(busctl --user get-property org.kde.ScreenBrightness "$d" org.kde.ScreenBrightness.Display MaxBrightness | awk '{print $2}')
        busctl --user call org.kde.ScreenBrightness "$d" org.kde.ScreenBrightness.Display SetBrightness iu $(( $2 * max / 100 )) 0 ;;
    focus)
        if [ "$2" = on ]; then
            "$KW" --file plasmanotifyrc --group DoNotDisturb --key Until "2999-12-31T23:59:59"
        else
            "$KW" --file plasmanotifyrc --group DoNotDisturb --key Until --delete
        fi ;;
    wifi-list)   # in-use<TAB>ssid<TAB>signal<TAB>security<TAB>known(1/0)
        known="$(nmcli -t -f NAME,TYPE con show 2>/dev/null | sed -n 's/:802-11-wireless$//p')"
        nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan auto 2>/dev/null \
            | sed 's/\\:/\x01/g; s/:/\t/g; s/\x01/:/g' | awk -F'\t' '$2 != "" && !seen[$2]++' | head -12 \
            | while IFS=$'\t' read -r use ssid sig sec; do
                printf '%s\t%s\t%s\t%s\t%s\n' "$use" "$ssid" "$sig" "$sec" "$(grep -qxF "$ssid" <<<"$known" && echo 1 || echo 0)"
              done ;;
    wifi-connect)
        # known or open network: just connect. Secured new network: the password comes
        # on stdin (never on the command line, so other programs can't read it).
        if nmcli con up id "$2" >/dev/null 2>&1; then exit 0; fi
        if [ "${3:-}" = "--password-stdin" ]; then
            IFS= read -r pw
            printf '%s\n' "$pw" | nmcli --ask dev wifi connect "$2" >/dev/null 2>&1; rc=$?
            unset pw; exit $rc
        fi
        nmcli dev wifi connect "$2" >/dev/null 2>&1 ;;
    bt-list)
        conn="$(bluetoothctl devices Connected 2>/dev/null | awk '{print $2}')"
        bluetoothctl devices Paired 2>/dev/null | while read -r _ mac name; do
            printf '%s\t%s\t%s\n' "$mac" "$name" "$(grep -qx "$mac" <<<"$conn" && echo 1 || echo 0)"
        done ;;
    bt-device)
        if bluetoothctl devices Connected 2>/dev/null | grep -q " $2 "; then
            bluetoothctl disconnect "$2" >/dev/null
        else
            bluetoothctl connect "$2" >/dev/null
        fi ;;
    *) echo "usage: ravana-cc status|wifi|bluetooth|volume|mute|brightness|focus|wifi-list|wifi-connect|bt-list|bt-device" >&2; exit 2 ;;
esac
